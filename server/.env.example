NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/interviewai
# Generate a unique 32+ character random secret. Never commit the real value.
JWT_SECRET=replace_with_a_32_character_or_longer_random_secret
JWT_EXPIRE=30d
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
# Required in production for password-reset email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=InterviewAI <security@your-domain.com>
